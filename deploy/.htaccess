# Option Builder — web-root config for Apache / LiteSpeed shared hosting.
# Copied into the release folder by scripts/package-release.mjs.

Options -Indexes
DirectoryIndex index.html index.php

# --- one address ----------------------------------------------------------------
# The app lives at https://optionbuilder.adddots.com/. Its folder is also
# public_html/opbuilder/ of the main site, so www.adddots.com/opbuilder/
# (where the root-relative asset URLs would not load) and plain http are
# sent there.
# api/ has its own rewrite rules, so API calls are not redirected.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^optionbuilder\.adddots\.com$ [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://optionbuilder.adddots.com/$1 [R=301,L]
</IfModule>

# --- security headers ---------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Scripts and API calls stay on this origin; Google Identity Services and
    # the Drive API are allowed for the Instagram carousel's "Save to Drive".
    # style-src needs 'unsafe-inline' for React style attributes.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://www.googleapis.com https://accounts.google.com https://oauth2.googleapis.com; frame-src https://accounts.google.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

    # Fingerprinted bundles never change; the HTML must always be fresh so a
    # deploy takes effect immediately.
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|svg|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Source maps are for debugging, not for the public.
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>

# --- compression --------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
