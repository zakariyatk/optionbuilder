# AddStock API — Apache/LiteSpeed config for shared hosting.

# --- protect everything that isn't meant to be fetched -----------------------
# config.php holds the Upstox secret and app password; data/ holds the live
# broker token and cache. Neither should ever be served.
<FilesMatch "^(config|config\.example)\.php$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/.*/data/
RedirectMatch 404 ^/.*/lib/

Options -Indexes

# --- route every request to the front controller -----------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Leave real files alone (nothing else lives here, but be explicit).
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

# --- responses are per-session and time-sensitive -----------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Cache-Control "no-store"
</IfModule>
