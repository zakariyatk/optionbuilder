{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AddStock",
  "version": "0.1.0",
  "identifier": "com.adddots.addstock",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "ADD DOTS",
    "shortDescription": "Option Builder for Windows",
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["addstock"] }
    }
  }
}
