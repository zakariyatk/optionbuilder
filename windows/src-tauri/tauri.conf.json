{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AddStock",
  "version": "0.3.0",
  "identifier": "com.adddots.addstock",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "ADD DOTS",
    "shortDescription": "Option Builder for Windows",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "addstock"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5REYxMUVCODc2QTU1ODYKUldTR1ZXcUg2eEhmZVdCSUwzc0l4L2l5UFBNUkt3V1FGc1ZMRXQ3YWRpR1BUSUNkR0F4M0xLV20K",
      "endpoints": [
        "https://github.com/zakariyatk/optionbuilder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
